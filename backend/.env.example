# AICTE WATCHTOWER Environment Configuration
APP_NAME=AICTE Watchtower
APP_ENV=demo
DEBUG=True
SECRET_KEY=aicte-watchtower-sih-2026-super-secret-jwt-key-demo-38291
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - Defaults to SQLite for immediate, zero-friction local run; supports PostgreSQL via postgresql+psycopg2://user:pass@localhost:5432/aicte_watchtower
DATABASE_URL=sqlite:///./watchtower.db

# File Storage
STORAGE_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10

# SMTP Email (MailHog or real SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=watchtower@aicte-india.org
EMAILS_FROM_NAME=AICTE Watchtower Alert System

# Redis (for optional Celery background tasks)
REDIS_URL=redis://localhost:6379/0
